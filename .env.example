# Required: keep real values out of version control.
MSSQL_SERVER=localhost
MSSQL_AUTH=sql

# Optional for Windows Authentication; set only when you want a fixed database.
MSSQL_DATABASE=replica_database

# Required only when MSSQL_AUTH=sql.
MSSQL_USERNAME=readonly_user
MSSQL_PASSWORD=replace_me

# Optional.
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MCP_SQL_MAX_ROWS=200
MCP_SQL_TIMEOUT_SECONDS=30
